---
import Base from "../layouts/Base.astro";
import { formatDateZh, formatYear } from "../lib/dates";
import { getPublishedPosts, postHref } from "../lib/posts";

const posts = await getPublishedPosts();
const byYear = new Map<string, typeof posts>();
for (const item of posts) {
  const year = formatYear(item.post.data.date);
  const list = byYear.get(year) ?? [];
  list.push(item);
  byYear.set(year, list);
}
const years = [...byYear.keys()].sort((a, b) => Number(b) - Number(a));
---

<Base title="归档" description="按时间排列的全部笔记。">
  <h1 class="page-title">归档</h1>
  {
    years.map((year) => (
      <section class="archive-year">
        <h2>{year}</h2>
        <ul>
          {byYear.get(year)!.map(({ post }) => (
            <li>
              <time datetime={post.data.date.toISOString()}>{formatDateZh(post.data.date)}</time>
              <a href={postHref(post)}>{post.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
