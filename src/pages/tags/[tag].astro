---
import PostCard from "../../components/PostCard.astro";
import Base from "../../layouts/Base.astro";
import { allTags, getPublishedPosts } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return allTags(posts).map((tag) => ({
    params: { tag },
    props: {
      tag,
      items: posts.filter(({ post }) => post.data.tags.includes(tag)),
    },
  }));
}

const { tag, items } = Astro.props;
---

<Base title={tag} description={`标签「${tag}」下的笔记。`}>
  <h1 class="page-title">#{tag}</h1>
  {items.map((item) => <PostCard item={item} />)}
</Base>
