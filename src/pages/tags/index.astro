---
import Base from "../../layouts/Base.astro";
import { allTags, getPublishedPosts } from "../../lib/posts";

const posts = await getPublishedPosts();
const tags = allTags(posts);
---

<Base title="标签" description="按标签浏览笔记。">
  <h1 class="page-title">标签</h1>
  <div class="tag-cloud">
    {
      tags.map((tag) => (
        <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>
          {tag}
        </a>
      ))
    }
  </div>
</Base>
