---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatDate } from "../../lib/dates";
import { getPublishedPosts, postSlug } from "../../lib/posts";
import { site } from "../../lib/site";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((item) => ({
    params: { slug: postSlug(item.post) },
    props: item,
  }));
}

const { post, minutes } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  <article>
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        日期：{formatDate(post.data.date)} | 预计阅读：{minutes} 分钟 | 作者：{site.author}
      </div>
      {
        (post.data.source || post.data.authors || post.data.link) && (
          <p class="post-source">
            {post.data.source}
            {post.data.authors ? ` · ${post.data.authors}` : ""}
            {post.data.link && (
              <>
                {" · "}
                <a href={post.data.link} target="_blank" rel="noopener">
                  原文
                </a>
              </>
            )}
          </p>
        )
      }
      {
        post.data.tags.length > 0 && (
          <div class="post-tags">
            {post.data.tags.map((tag) => (
              <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>
                {tag}
              </a>
            ))}
          </div>
        )
      }
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
